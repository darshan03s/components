{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "registry",
  "homepage": "https://components.darshans.site",
  "items": [
    {
      "name": "media-player",
      "type": "registry:block",
      "title": "Media Player",
      "description": "A media player component for audio and video files",
      "registryDependencies": ["button", "dialog", "item", "card", "dropdown-menu", "slider"],
      "dependencies": ["mediabunny@^1.50.6"],
      "files": [
        {
          "type": "registry:component",
          "path": "src/components/media-player/index.ts",
          "target": "@components/media-player/index.ts"
        },
        {
          "type": "registry:component",
          "path": "src/components/media-player/info-modal.tsx",
          "target": "@components/media-player/info-modal.tsx"
        },
        {
          "type": "registry:component",
          "path": "src/components/media-player/mediabunny.ts",
          "target": "@components/media-player/mediabunny.ts"
        },
        {
          "type": "registry:component",
          "path": "src/components/media-player/player.tsx",
          "target": "@components/media-player/player.tsx"
        },
        {
          "type": "registry:component",
          "path": "src/components/media-player/provider.tsx",
          "target": "@components/media-player/provider.tsx"
        },
        {
          "type": "registry:component",
          "path": "src/components/media-player/utils.ts",
          "target": "@components/media-player/utils.ts"
        }
      ]
    },
    {
      "name": "webcontainer-ide",
      "type": "registry:block",
      "title": "WebContainer IDE",
