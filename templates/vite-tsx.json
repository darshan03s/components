  "vite.config.ts": {
    "file": {
      "contents": "import { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\n\n// https://vite.dev/config/\nexport default defineConfig({\n  plugins: [react()]\n})\n"
    }
